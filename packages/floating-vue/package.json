{
  "name": "floating-vue",
  "version": "5.3.0",
  "description": "Easy Vue tooltips, dropdowns, menus & popovers using floating-ui",
  "author": "Guillaume Chau <guillaume.b.chau@gmail.com>",
  "license": "MIT",
  "homepage": "https://floating-vue.starpad.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akryum/floating-vue.git",
    "directory": "packages/floating-vue"
  },
  "bugs": {
    "url": "https://github.com/Akryum/floating-vue/issues"
  },
  "keywords": [
    "vue",
    "popper",
    "tooltip",
    "popover",
    "dropdown",
    "menu"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/floating-vue.mjs",
      "require": "./dist/floating-vue.umd.js"
    },
    "./nuxt": "./nuxt.mjs",
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "main": "dist/floating-vue.umd.js",
  "module": "dist/floating-vue.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "*.mjs",
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development vite build --watch",
    "build": "NODE_ENV=production vite build && vue-tsc -d --emitDeclarationOnly",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.2.0 || ^4.0.0 || ^5.0.0-0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "~1.1.1"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.21.11",
    "@vitejs/plugin-vue": "^4.6.2",
    "fs-extra": "^11.4.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "vue-typegen": "^0.2.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
