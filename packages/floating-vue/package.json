{
  "name": "floating-vue",
  "version": "5.2.2",
  "description": "Easy Vue tooltips, dropdowns, menus & popovers using floating-ui",
  "author": "Guillaume Chau <guillaume.b.chau@gmail.com>",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "cross-env NODE_ENV=production vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check:package": "pnpm run validate:package && pnpm run typecheck:package",
    "prepublishOnly": "pnpm run test && pnpm run build && pnpm run check:package",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:package": "vue-tsc -p tsconfig.package-node.json --noEmit && vue-tsc -p tsconfig.package-node16.json --noEmit && vue-tsc -p tsconfig.package-bundler.json --noEmit",
    "validate:package": "node ./scripts/validate-package.mjs"
  },
  "main": "dist/floating-vue.umd.js",
  "module": "dist/floating-vue.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/floating-vue.umd.js",
      "import": "./dist/floating-vue.mjs"
    },
    "./nuxt": "./nuxt.mjs",
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "*.mjs"
  ],
  "dependencies": {
    "@floating-ui/dom": "~1.6.3"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.2.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.6.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/server-renderer": "^3.3.4",
    "@vue/test-utils": "^2.4.9",
    "cross-env": "^7.0.3",
    "happy-dom": "^15.7.4",
    "vite": "^4.3.9",
    "vitest": "^2.1.0",
    "vue": "^3.3.4",
    "vue-tsc": "^3.2.7"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "bugs": {
    "url": "https://github.com/Akryum/floating-vue/issues"
  },
  "homepage": "https://floating-vue.starpad.dev/",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vue",
    "popper",
    "tooltip",
    "popover",
    "dropdown",
    "menu"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akryum/floating-vue.git",
    "directory": "packages/floating-vue"
  }
}
