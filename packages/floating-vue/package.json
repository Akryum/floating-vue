{
  "name": "floating-vue",
  "type": "commonjs",
  "version": "5.4.0",
  "description": "Easy Vue tooltips, dropdowns, menus & popovers using floating-ui",
  "author": "Guillaume Chau <guillaume.b.chau@gmail.com>",
  "license": "MIT",
  "homepage": "https://floating-vue.starpad.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akryum/floating-vue.git",
    "directory": "packages/floating-vue"
  },
  "bugs": {
    "url": "https://github.com/Akryum/floating-vue/issues"
  },
  "keywords": [
    "vue",
    "popper",
    "tooltip",
    "popover",
    "dropdown",
    "menu"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/floating-vue.d.mts",
        "default": "./dist/floating-vue.mjs"
      },
      "require": {
        "types": "./dist/floating-vue.d.ts",
        "default": "./dist/floating-vue.umd.js"
      }
    },
    "./nuxt": "./nuxt.mjs",
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "main": "dist/floating-vue.umd.js",
  "module": "dist/floating-vue.mjs",
  "types": "dist/floating-vue.d.ts",
  "files": [
    "*.mjs",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.2.0 || ^4.0.0 || ^5.0.0-0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.21.11",
    "tsdown": "^0.23.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
