{
  "compilerOptions": {
    "target": "ES2018",
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  }
}
